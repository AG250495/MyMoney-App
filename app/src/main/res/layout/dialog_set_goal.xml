<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Establecer meta de ahorro"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvDialogPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¿Cuánto dinero quieres ahorrar este mes?"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etGoalAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ej. 20.00"
        android:inputType="numberDecimal"
        android:background="@drawable/bg_rounded_input"
        android:padding="12dp" />

</LinearLayout>